{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Dreamari semantic tokens for light mode. Every semantic decision aliases a primitive; no resolved palette value is duplicated here.",
  "$extensions": {
    "com.dreamari.collection": "semantic",
    "com.dreamari.mode": "light"
  },
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": "{color.neutral.900}",
        "$description": "Primary headings and high-emphasis text on light surfaces."
      },
      "secondary": {
        "$value": "{color.neutral.600}",
        "$description": "Body copy and secondary labels on light surfaces."
      },
      "muted": {
        "$value": "{color.neutral.600}",
        "$description": "Muted readable text; intentionally uses neutral 600 to meet normal-text contrast."
      },
      "inverse": {
        "$value": "{color.white}",
        "$description": "Text displayed on dark or saturated surfaces."
      },
      "on-media": {
        "$value": "{color.white}",
        "$description": "High-emphasis text placed over cinematic imagery or saturated media."
      },
      "on-media-secondary": {
        "$value": "{color.neutral.200}",
        "$description": "Supporting text placed over cinematic imagery or saturated media."
      },
      "on-media-muted": {
        "$value": "{color.neutral.300}",
        "$description": "Low-emphasis metadata placed over cinematic imagery or saturated media."
      },
      "on-warning": {
        "$value": "{color.neutral.900}",
        "$description": "Readable compact text placed on amber or yellow warning and reward surfaces."
      },
      "brand": {
        "$value": "{color.day.link}",
        "$description": "Brand-coloured text and links, AAA in light and AA at the sky's brightest point in dark."
      }
    },
    "surface": {
      "page": {
        "$value": "{color.day.page}",
        "$description": "App page background."
      },
      "card": {
        "$value": "{color.white}",
        "$description": "Default card fill."
      },
      "subtle": {
        "$value": "{color.neutral.50}",
        "$description": "Subtle nested panel or option surface."
      },
      "navigation": {
        "$value": "{color.white}",
        "$description": "Primary application navigation surface in light mode."
      },
      "home-card": {
        "$value": "{color.white}",
        "$description": "Career-discovery card body surface in light mode."
      },
      "feature": {
        "$value": "{color.day.feature}",
        "$description": "Feature surface in light: pale ice blue (19 Oct 2026)."
      },
      "feature-strong": {
        "$value": "{color.day.feature-strong}",
        "$description": "Stronger feature surface in light: ice blue (19 Oct 2026)."
      },
      "media-overlay": {
        "$value": "{color.black}",
        "$description": "Absolute overlay foundation used to protect text over media."
      },
      "brand": {
        "$value": "{color.brand.950}",
        "$description": "Dark branded landing surface."
      },
      "match-toast": {
        "$value": "{color.match.toast-background}",
        "$description": "Always-dark Match toast surface."
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.75}",
        "$description": "Low-emphasis border on light surfaces."
      },
      "default": {
        "$value": "{color.neutral.200}",
        "$description": "Default form and panel border."
      },
      "strong": {
        "$value": "{color.neutral.400}",
        "$description": "High-emphasis neutral border."
      }
    },
    "action": {
      "primary": {
        "$value": "{color.brand.600}",
        "$description": "Primary action fill on light surfaces: dusk cobalt, white ink."
      },
      "primary-hover": {
        "$value": "{color.brand.700}",
        "$description": "Primary action hover."
      },
      "secondary": {
        "$value": "{color.accent.sky}",
        "$description": "Secondary interactive action."
      },
      "primary-foreground": {
        "$value": "{color.white}",
        "$description": "Ink on a primary action fill."
      }
    },
    "feedback": {
      "success": {
        "$value": "{color.status.success.ink}",
        "$description": "Success text and indicator."
      },
      "success-dark-surface": {
        "$value": "{color.match.success}",
        "$description": "Success indicator on the dark Match surface."
      },
      "danger": {
        "$value": "{color.status.danger.ink}",
        "$description": "Danger, error and destructive-state text and indicator (at risk, overdue)."
      },
      "success-solid": {
        "$value": "{color.status.success.solid}",
        "$description": "Success fill for dots, bars and solid badges."
      },
      "success-subtle": {
        "$value": "{color.status.success.subtle}",
        "$description": "Success tint behind a chip or banner."
      },
      "warning": {
        "$value": "{color.status.warning.ink}",
        "$description": "Warning text and indicator (needs attention, due soon)."
      },
      "warning-solid": {
        "$value": "{color.status.warning.solid}",
        "$description": "Warning fill for dots, bars and solid badges."
      },
      "warning-subtle": {
        "$value": "{color.status.warning.subtle}",
        "$description": "Warning tint behind a chip or banner."
      },
      "danger-solid": {
        "$value": "{color.status.danger.solid}",
        "$description": "Danger fill for dots, bars and solid badges."
      },
      "danger-subtle": {
        "$value": "{color.status.danger.subtle}",
        "$description": "Danger tint behind a chip or banner."
      },
      "info": {
        "$value": "{color.status.info.ink}",
        "$description": "Informational text and indicator."
      },
      "info-solid": {
        "$value": "{color.status.info.solid}",
        "$description": "Info fill for dots, bars and solid badges."
      },
      "info-subtle": {
        "$value": "{color.status.info.subtle}",
        "$description": "Info tint behind a chip or banner."
      }
    },
    "elevation": {
      "card": {
        "$value": "{color.shadow.blue-10}",
        "$description": "Mode-aware shadow color for elevated cards and controls."
      },
      "overlay": {
        "$value": "{color.shadow.black-40}",
        "$description": "Shadow color for controls floating above cinematic media."
      }
    },
    "category": {
      "classes": {
        "$value": "{color.red.500}",
        "$description": "Match Classes category."
      },
      "earning-potential": {
        "$value": "{color.purple.500}",
        "$description": "Match Earning Potential category."
      },
      "future-fit": {
        "$value": "{color.green.450}",
        "$description": "Match Future Fit category."
      }
    },
    "ui": {
      "$description": "The flat theme vocabulary the app paints with (shadcn role names). Each token names its runtime CSS variable; production maps these 1:1 onto its own tokens of the same name.",
      "background": {
        "$value": "{color.day.page}",
        "$description": "Page background. Runtime name --background."
      },
      "foreground": {
        "$value": "{color.day.ink}",
        "$description": "Body text. Runtime name --foreground."
      },
      "card": {
        "$value": "{color.white}",
        "$description": "Card fill. Runtime name --card."
      },
      "surface": {
        "$value": "{color.white}",
        "$description": "Raised surface (sheets, rails). Runtime name --surface."
      },
      "muted": {
        "$value": "{color.day.muted}",
        "$description": "Muted fill. Runtime name --muted."
      },
      "muted-foreground": {
        "$value": "{color.day.ink-muted}",
        "$description": "Secondary text. Runtime name --muted-foreground."
      },
      "border": {
        "$value": "{color.day.border}",
        "$description": "Card and divider border. Runtime name --border."
      },
      "primary": {
        "$value": "{color.brand.600}",
        "$description": "Primary fill: buttons, selected tabs, progress. Runtime name --primary. Dark is periwinkle with dark ink; light is cobalt with white ink."
      },
      "primary-hover": {
        "$value": "{color.brand.700}",
        "$description": "Primary fill on hover."
      },
      "primary-foreground": {
        "$value": "{color.white}",
        "$description": "Text and icons on a primary fill. Runtime name --primary-foreground. Never hard-code white: dark mode needs dark ink."
      },
      "secondary": {
        "$value": "{color.day.secondary}",
        "$description": "Secondary fill. Runtime name --secondary."
      },
      "secondary-foreground": {
        "$value": "{color.day.secondary-ink}",
        "$description": "Text on a secondary fill. Runtime name --secondary-foreground."
      },
      "accent": {
        "$value": "{color.brand.600}",
        "$description": "Accent fill, same as primary. Runtime name --accent."
      },
      "accent-subtle": {
        "$value": "{color.day.link}",
        "$description": "Text-safe brand blue for links and brand words. Runtime name --accent-subtle."
      },
      "destructive": {
        "$value": "{color.status.danger.ink}",
        "$description": "Destructive text and icons. Runtime name --destructive."
      },
      "glass-surface-1": {
        "$value": "{color.white}",
        "$description": "Glass rung 1. Light is solid white (translucent white read grey on the tinted page). Runtime name --glass-surface-1."
      },
      "glass-surface-2": {
        "$value": "{color.white}",
        "$description": "Glass rung 2. Runtime name --glass-surface-2."
      },
      "glass-surface-3": {
        "$value": "{color.white}",
        "$description": "Glass rung 3. Runtime name --glass-surface-3."
      },
      "glass-border": {
        "$value": "{color.day.glass-border}",
        "$description": "Hairline on glass. Runtime name --glass-border."
      },
      "inset-surface": {
        "$value": "{color.day.page}",
        "$description": "Inset well. Runtime name --inset-surface."
      },
      "inset-border": {
        "$value": "{color.day.inset-border}",
        "$description": "Inset well border. Runtime name --inset-border."
      },
      "scrim-base": {
        "$value": "{color.day.scrim-deep}",
        "$description": "Solid end of a photo scrim (the colour text sits on under a photo). Light is frost, dark is the page navy."
      },
      "scrim-ink": {
        "$value": "{color.day.secondary-ink}",
        "$description": "Title ink on a photo scrim."
      },
      "scrim-ink-soft": {
        "$value": "{color.day.scrim-ink-soft}",
        "$description": "Secondary ink on a photo scrim."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "hero": {
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontSize": "{dimension.font-size.5xl}",
          "fontWeight": "{fontWeight.extrabold}",
          "letterSpacing": "{dimension.letter-spacing.tight}",
          "lineHeight": "{number.line-height.tight}"
        },
        "$description": "Large Dreamari display heading in Bricolage Grotesque, the one display face across landing and app."
      }
    },
    "heading": {
      "page": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.4xl}",
          "fontWeight": "{fontWeight.extrabold}",
          "letterSpacing": "{dimension.letter-spacing.tight}",
          "lineHeight": "{number.line-height.heading}"
        },
        "$description": "Primary page heading."
      },
      "section": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.3xl}",
          "fontWeight": "{fontWeight.extrabold}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.heading}"
        },
        "$description": "Section and flow heading."
      },
      "card": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.2xl}",
          "fontWeight": "{fontWeight.bold}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.heading}"
        },
        "$description": "Card heading."
      }
    },
    "body": {
      "large": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.lg}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.body}"
        },
        "$description": "Large introductory body text."
      },
      "default": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.body-lg}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.body}"
        },
        "$description": "Default body text."
      },
      "small": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.body-sm}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.body}"
        },
        "$description": "Compact supporting body text."
      }
    },
    "label": {
      "default": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.body-sm}",
          "fontWeight": "{fontWeight.semibold}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.compact}"
        },
        "$description": "Form and control label."
      },
      "eyebrow": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.micro}",
          "fontWeight": "{fontWeight.bold}",
          "letterSpacing": "{dimension.letter-spacing.eyebrow}",
          "lineHeight": "{number.line-height.compact}"
        },
        "$description": "Uppercase eyebrow label."
      },
      "caption": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.caption}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.compact}"
        },
        "$description": "Citation and microcopy style."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "{color.shadow.amber-12}",
        "offsetX": "{dimension.spacing.0}",
        "offsetY": "{dimension.spacing.0}",
        "blur": "{dimension.spacing.24}",
        "spread": "{dimension.spacing.0}"
      },
      "$description": "Light Flow card glow."
    },
    "selection": {
      "$value": {
        "color": "{color.shadow.blue-10}",
        "offsetX": "{dimension.spacing.0}",
        "offsetY": "{dimension.spacing.4}",
        "blur": "{dimension.spacing.24}",
        "spread": "{dimension.spacing.0}"
      },
      "$description": "Light selection-card elevation."
    }
  }
}
