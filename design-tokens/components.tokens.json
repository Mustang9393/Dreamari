{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Dreamari component tokens. This mode-independent collection aliases semantic or foundation paths so light/dark selection happens without changing component token names.",
  "$extensions": {
    "com.dreamari.collection": "components"
  },
  "component": {
    "input": {
      "$description": "Text input and select foundation.",
      "background": {
        "$type": "color",
        "$value": "{color.surface.card}",
        "$description": "Input background."
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Input value text."
      },
      "label": {
        "$type": "color",
        "$value": "{color.text.secondary}",
        "$description": "Input label text."
      },
      "border": {
        "$type": "color",
        "$value": "{color.border.default}",
        "$description": "Input default border."
      },
      "focus-border": {
        "$type": "color",
        "$value": "{color.action.primary}",
        "$description": "Default input focus border outside step-themed contexts."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{dimension.radius.sm}",
        "$description": "Input corner radius."
      },
      "height": {
        "$type": "dimension",
        "$value": "{dimension.control-height.sm}",
        "$description": "Minimum input height."
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{dimension.spacing.16}",
        "$description": "Input horizontal padding."
      },
      "typography": {
        "$type": "typography",
        "$value": "{typography.label.default}",
        "$description": "Input value typography."
      }
    },
    "progress": {
      "$description": "Build progress panel foundation; fill color is the active step semantic accent.",
      "background": {
        "$type": "color",
        "$value": "{color.surface.subtle}",
        "$description": "Progress panel background foundation."
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.brand}",
        "$description": "Progress label fallback color."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{dimension.radius.md}",
        "$description": "Progress panel corner radius."
      },
      "transition": {
        "$type": "duration",
        "$value": "{duration.slow}",
        "$description": "Progress theme transition."
      }
    },
    "toast": {
      "$description": "Always-dark Match feedback toast.",
      "background": {
        "$type": "color",
        "$value": "{color.surface.match-toast}",
        "$description": "Toast background."
      },
      "text": {
        "$type": "color",
        "$value": "{color.white}",
        "$description": "Toast message."
      },
      "action": {
        "$type": "color",
        "$value": "{color.match.toast-link}",
        "$description": "Toast undo action."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{dimension.radius.pill}",
        "$description": "Toast pill radius."
      },
      "padding-inline": {
        "$type": "dimension",
        "$value": "{dimension.spacing.20}",
        "$description": "Toast horizontal padding."
      },
      "padding-block": {
        "$type": "dimension",
        "$value": "{dimension.spacing.12}",
        "$description": "Toast vertical padding."
      }
    },
    "home-card": {
      "$description": "Career card used throughout launchpad content rails.",
      "background": {
        "$type": "color",
        "$value": "{color.surface.home-card}",
        "$description": "Mode-aware card body and image-fade surface."
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Career-card title color."
      },
      "description": {
        "$type": "color",
        "$value": "{color.text.secondary}",
        "$description": "Career-card description color."
      },
      "metadata": {
        "$type": "color",
        "$value": "{color.text.muted}",
        "$description": "Career-card tags and secondary metadata."
      },
      "media-metadata": {
        "$type": "color",
        "$value": "{color.text.on-media}",
        "$description": "Duration text placed over card imagery."
      },
      "media-label-background": {
        "$type": "color",
        "$value": "{color.surface.media-overlay}",
        "$description": "Contrast-protecting background behind card duration metadata."
      },
      "border": {
        "$type": "color",
        "$value": "{color.border.default}",
        "$description": "Light-mode definition and dark-mode separation for career cards."
      },
      "shadow-color": {
        "$type": "color",
        "$value": "{color.elevation.card}",
        "$description": "Mode-aware career-card shadow color."
      },
      "radius": {
        "$type": "dimension",
        "$value": "{dimension.radius.sm}",
        "$description": "Career-card radius matching the approved UIKIT component."
      }
    },
    "cta": {
      "$description": "The CTA. Primary is the primary fill with primary-foreground ink, radius 12, never a pill (decided Aug to Sept 2026; the white primary was retired 4 Sept 2026). Secondary is glass with a hairline. Destructive variant intentionally absent.",
      "typography": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.cta}",
          "fontSize": "{dimension.font-size.body-lg}",
          "fontWeight": "{fontWeight.semibold}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.cta}"
        },
        "$description": "CTA label: UI/Body, Bricolage Grotesque SemiBold 16/22."
      },
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{color.ui.primary}",
          "$description": "Primary CTA fill."
        },
        "text": {
          "$type": "color",
          "$value": "{color.ui.primary-foreground}",
          "$description": "Primary CTA label ink."
        },
        "hover-background": {
          "$type": "color",
          "$value": "{color.ui.primary-hover}",
          "$description": "Primary CTA fill on hover."
        },
        "hover-text": {
          "$type": "color",
          "$value": "{color.ui.primary-foreground}",
          "$description": "Primary CTA label ink on hover."
        },
        "pressed-background": {
          "$type": "color",
          "$value": "{color.ui.primary-hover}",
          "$description": "Primary CTA fill while pressed."
        },
        "pressed-text": {
          "$type": "color",
          "$value": "{color.ui.primary-foreground}",
          "$description": "Primary CTA label ink while pressed."
        },
        "disabled-opacity": {
          "$type": "number",
          "$value": "{number.opacity.disabled}",
          "$description": "Primary/Disabled: whole control at 40% opacity over the Default scheme."
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{color.ui.glass-surface-2}",
          "$description": "Secondary CTA fill."
        },
        "border": {
          "$type": "color",
          "$value": "{color.ui.glass-border}",
          "$description": "Secondary CTA hairline."
        },
        "text": {
          "$type": "color",
          "$value": "{color.ui.foreground}",
          "$description": "Secondary CTA label ink."
        },
        "hover-background": {
          "$type": "color",
          "$value": "{color.ui.glass-surface-1}",
          "$description": "Secondary CTA fill on hover."
        },
        "hover-text": {
          "$type": "color",
          "$value": "{color.ui.foreground}",
          "$description": "Secondary CTA label ink."
        },
        "pressed-background": {
          "$type": "color",
          "$value": "{color.ui.primary}",
          "$description": "Secondary CTA fill while pressed."
        },
        "pressed-text": {
          "$type": "color",
          "$value": "{color.ui.primary-foreground}",
          "$description": "Secondary CTA label ink while pressed."
        },
        "disabled-content-opacity": {
          "$type": "number",
          "$value": "{number.opacity.disabled-content}",
          "$description": "Secondary/Disabled: label and icon at 78% opacity; surface unchanged."
        }
      },
      "size": {
        "default": {
          "padding-x": {
            "$type": "dimension",
            "$value": "{dimension.spacing.16}",
            "$description": "Default size horizontal padding. Figma binding: var(--space-4)."
          },
          "padding-y": {
            "$type": "dimension",
            "$value": "{dimension.spacing.8}",
            "$description": "Default size vertical padding. Figma binding: var(--space-2)."
          },
          "radius": {
            "$type": "dimension",
            "$value": "{dimension.radius.sm}",
            "$description": "Default size corner radius. Figma binding: var(--radius-md)."
          }
        },
        "large": {
          "padding-x": {
            "$type": "dimension",
            "$value": "{dimension.spacing.24}",
            "$description": "Large size horizontal padding. Figma binding: var(--primitive-space-6)."
          },
          "padding-y": {
            "$type": "dimension",
            "$value": "{dimension.spacing.16}",
            "$description": "Large size vertical padding. Figma binding: var(--primitive-space-4)."
          },
          "radius": {
            "$type": "dimension",
            "$value": "{dimension.radius.md}",
            "$description": "Large size corner radius. Figma binding: var(--primitive-radius-lg)."
          }
        }
      },
      "gap": {
        "$type": "dimension",
        "$value": "{dimension.spacing.4}",
        "$description": "Gap between label and icon slot. Figma binding: var(--space-1) = 4px."
      },
      "icon-size": {
        "$type": "dimension",
        "$value": "{dimension.spacing.16}",
        "$description": "Icon slot square size (16px)."
      }
    }
  }
}
