{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Dreamari semantic tokens for dark mode. Paths mirror light mode so consumers switch modes without changing token names.",
  "$extensions": {
    "com.dreamari.collection": "semantic",
    "com.dreamari.mode": "dark"
  },
  "color": {
    "$type": "color",
    "text": {
      "primary": {
        "$value": "{color.white}",
        "$description": "Primary text on dark surfaces."
      },
      "secondary": {
        "$value": "{color.neutral.300}",
        "$description": "Body copy on dark surfaces."
      },
      "muted": {
        "$value": "{color.neutral.400}",
        "$description": "Muted readable text on dark surfaces."
      },
      "inverse": {
        "$value": "{color.neutral.900}",
        "$description": "Text displayed on light surfaces."
      },
      "on-media": {
        "$value": "{color.white}",
        "$description": "High-emphasis text placed over cinematic imagery or saturated media."
      },
      "on-media-secondary": {
        "$value": "{color.neutral.200}",
        "$description": "Supporting text placed over cinematic imagery or saturated media."
      },
      "on-media-muted": {
        "$value": "{color.neutral.300}",
        "$description": "Low-emphasis metadata placed over cinematic imagery or saturated media."
      },
      "on-warning": {
        "$value": "{color.neutral.900}",
        "$description": "Readable compact text placed on amber or yellow warning and reward surfaces."
      },
      "brand": {
        "$value": "{color.brand.300}",
        "$description": "Brand-emphasis text on dark surfaces."
      }
    },
    "surface": {
      "page": {
        "$value": "{color.aurora.canvas-dark}",
        "$description": "Default dark-mode application background."
      },
      "card": {
        "$value": "{color.neutral.900}",
        "$description": "Primary dark card foundation beneath implementation opacity and blur."
      },
      "subtle": {
        "$value": "{color.neutral.800}",
        "$description": "Subtle nested dark panel."
      },
      "navigation": {
        "$value": "{color.neutral.950}",
        "$description": "Primary application navigation surface in dark mode."
      },
      "home-card": {
        "$value": "{color.match.card-background}",
        "$description": "Career-discovery card body surface in dark mode."
      },
      "feature": {
        "$value": "{color.brand.950}",
        "$description": "Dark branded feature-panel surface."
      },
      "feature-strong": {
        "$value": "{color.navy.900}",
        "$description": "Stronger endpoint for dark feature-panel gradients."
      },
      "media-overlay": {
        "$value": "{color.black}",
        "$description": "Absolute overlay foundation used to protect text over media."
      },
      "brand": {
        "$value": "{color.brand.950}",
        "$description": "Dark branded landing surface."
      },
      "match-toast": {
        "$value": "{color.match.toast-background}",
        "$description": "Always-dark Match toast surface."
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.800}",
        "$description": "Low-emphasis border on dark surfaces."
      },
      "default": {
        "$value": "{color.neutral.700}",
        "$description": "Default dark form and panel border."
      },
      "strong": {
        "$value": "{color.neutral.500}",
        "$description": "High-emphasis dark neutral border."
      }
    },
    "action": {
      "primary": {
        "$value": "{color.match.accent}",
        "$description": "Primary interactive action on dark surfaces."
      },
      "primary-hover": {
        "$value": "{color.brand.400}",
        "$description": "Primary dark action hover state."
      },
      "secondary": {
        "$value": "{color.brand.300}",
        "$description": "Secondary interactive action on dark surfaces."
      }
    },
    "feedback": {
      "success": {
        "$value": "{color.match.success}",
        "$description": "Success text and indicator on dark surfaces."
      },
      "success-dark-surface": {
        "$value": "{color.match.success}",
        "$description": "Success indicator on the dark Match surface."
      },
      "danger": {
        "$value": "{color.red.500}",
        "$description": "Danger and destructive state on dark surfaces."
      }
    },
    "elevation": {
      "card": {
        "$value": "{color.shadow.black-40}",
        "$description": "Mode-aware shadow color for elevated cards and controls."
      },
      "overlay": {
        "$value": "{color.shadow.black-40}",
        "$description": "Shadow color for controls floating above cinematic media."
      }
    },
    "category": {
      "classes": {
        "$value": "{color.red.500}",
        "$description": "Match Classes category."
      },
      "earning-potential": {
        "$value": "{color.purple.500}",
        "$description": "Match Earning Potential category."
      },
      "future-fit": {
        "$value": "{color.green.450}",
        "$description": "Match Future Fit category."
      }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "hero": {
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontSize": "{dimension.font-size.5xl}",
          "fontWeight": "{fontWeight.extrabold}",
          "letterSpacing": "{dimension.letter-spacing.tight}",
          "lineHeight": "{number.line-height.tight}"
        },
        "$description": "Large Dreamari display heading in Bricolage Grotesque, the one display face across landing and app."
      }
    },
    "heading": {
      "page": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.4xl}",
          "fontWeight": "{fontWeight.extrabold}",
          "letterSpacing": "{dimension.letter-spacing.tight}",
          "lineHeight": "{number.line-height.heading}"
        },
        "$description": "Primary page heading."
      },
      "section": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.3xl}",
          "fontWeight": "{fontWeight.extrabold}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.heading}"
        },
        "$description": "Section and flow heading."
      },
      "card": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.2xl}",
          "fontWeight": "{fontWeight.bold}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.heading}"
        },
        "$description": "Card heading."
      }
    },
    "body": {
      "large": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.lg}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.body}"
        },
        "$description": "Large introductory body text."
      },
      "default": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.body-lg}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.body}"
        },
        "$description": "Default body text."
      },
      "small": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.body-sm}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.body}"
        },
        "$description": "Compact supporting body text."
      }
    },
    "label": {
      "default": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.body-sm}",
          "fontWeight": "{fontWeight.semibold}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.compact}"
        },
        "$description": "Form and control label."
      },
      "eyebrow": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.micro}",
          "fontWeight": "{fontWeight.bold}",
          "letterSpacing": "{dimension.letter-spacing.eyebrow}",
          "lineHeight": "{number.line-height.compact}"
        },
        "$description": "Uppercase eyebrow label."
      },
      "caption": {
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "{dimension.font-size.caption}",
          "fontWeight": "{fontWeight.regular}",
          "letterSpacing": "{dimension.letter-spacing.normal}",
          "lineHeight": "{number.line-height.compact}"
        },
        "$description": "Citation and microcopy style."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": {
        "color": "{color.shadow.black-40}",
        "offsetX": "{dimension.spacing.0}",
        "offsetY": "{dimension.spacing.0}",
        "blur": "{dimension.spacing.32}",
        "spread": "{dimension.spacing.0}"
      },
      "$description": "Dark Flow card elevation."
    },
    "selection": {
      "$value": {
        "color": "{color.shadow.black-40}",
        "offsetX": "{dimension.spacing.0}",
        "offsetY": "{dimension.spacing.4}",
        "blur": "{dimension.spacing.24}",
        "spread": "{dimension.spacing.0}"
      },
      "$description": "Dark selection-card elevation."
    }
  }
}
